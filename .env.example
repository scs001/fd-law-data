# --- RustFS (S3) — required by crawler AND loader ---
# Crawler runs where the PUBLIC endpoint is reachable; loader may use the internal one.
RUSTFS_ENDPOINT=https://file.finddatatech.cloud
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_REGION=us-east-1

# --- Buckets ---
LAWS_BUCKET=laws
LAWS_EXPORT_BUCKET=laws-export

# --- incremental embed worker (flk-embed; no PG access) ---
# Key lives ONLY here / in the k8s Secret — never in code, docs, or artifacts:
# EMBED_API_KEY=sk-...
EMBED_ENDPOINT=https://api.siliconflow.cn/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
QDRANT_URL=http://100.64.0.9:6333
QDRANT_COLLECTION=law_chunks_v2

# --- flk crawler pacing ---
FLK_RATE_MS=1100
FLK_PAGE_SIZE=100
FLK_LOOKBACK_DAYS=7

# --- wenshu crawler (browser automation) ---
WENSHU_BUCKET=wenshu
WENSHU_RATE_MS=1000            # ~1 doc/s on detail fetches
WENSHU_LOOKBACK_DAYS=7
WENSHU_RESULT_CAP=200          # subdivide slices above the site's paginatable cap
WENSHU_BUDGET_MS=68400000      # 19 h nightly budget (deadline ~20 h incl. overhead)
# Account lives ONLY here / in the k8s Secret — never in code, docs, or artifacts:
# WENSHU_ACCOUNT_USER=...
# WENSHU_ACCOUNT_PASSWORD=...
# Sticky exit proxy (design.md D6; empty = direct connection):
# WENSHU_PROXY_URL=http://user:pass@proxy-host:port

# --- legal Auth Broker (independent login image; secrets via k8s Secret) ---
# 32-byte base64/hex key encrypts session jars. Never commit or log it:
# LEGAL_AUTH_JAR_KEY=...
# Internal API token used by crawler -> auth broker:
# LEGAL_AUTH_BROKER_TOKEN=...
# LEGAL_AUTH_BROKER_URL=http://legal-auth-broker.scraw
# Login and crawl should normally use the same fixed-exit identity:
# LEGAL_AUTH_LOGIN_PROXY_ID=...
# LEGAL_AUTH_CRAWL_PROXY_ID=...
# LEGAL_AUTH_LOGIN_PROXY_URL=http://user:pass@sticky-proxy:port
# LEGAL_AUTH_CRAWL_PROXY_URL=http://user:pass@sticky-proxy:port
# Browser profile root for the independent Auth Broker image:
LEGAL_AUTH_PROFILE_ROOT=/data/legal-auth/profiles

# --- loader only (data machine; PG is 127.0.0.1-only there) ---
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=change-me
# PG_DATABASE=law_db
