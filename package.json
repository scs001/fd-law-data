{
  "name": "fd-law-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incremental crawlers + loaders for Chinese legal open data (flk.npc.gov.cn regulations; wenshu judgments in a later change)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "crawl:flk": "node bin/flk-crawl.mjs",
    "load:flk": "node bin/flk-load.mjs",
    "backfill:flk": "node bin/flk-crawl.mjs --backfill --until 2026-09-23 --batch-days 365",
    "crawl:guide-cases": "node bin/guide-cases-crawl.mjs",
    "load:guide-cases": "node bin/guide-cases-load.mjs",
    "login:wenshu": "node bin/wenshu-login.mjs",
    "crawl:wenshu": "node bin/wenshu-crawl.mjs",
    "load:wenshu": "node bin/wenshu-load.mjs",
    "crawl:rmfyalk": "node bin/rmfyalk-crawl.mjs",
    "load:rmfyalk": "node bin/rmfyalk-load.mjs",
    "crawl:mfa-treaty": "node bin/mfa-treaty-crawl.mjs",
    "load:mfa-treaty": "node bin/mfa-treaty-load.mjs",
    "crawl:gov-rules": "node bin/gov-rules-crawl.mjs",
    "load:gov-rules": "node bin/gov-rules-load.mjs",
    "crawl:party-regulation": "node bin/party-regulation-crawl.mjs",
    "load:party-regulation": "node bin/party-regulation-load.mjs",
    "crawl:ccdi-supervisory": "node bin/ccdi-supervisory-crawl.mjs",
    "load:ccdi-supervisory": "node bin/ccdi-supervisory-load.mjs",
    "report:legal-sources": "node bin/legal-sources-report.mjs",
    "verify:legal-documents-ddl": "node scripts/verify-legal-documents-ddl.mjs",
    "verify:legal-identity-ddl": "node scripts/verify-legal-identity-ddl.mjs"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "playwright": "^1.63.0"
  }
}
